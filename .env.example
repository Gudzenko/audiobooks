# Keep real API keys only in .env. Never commit .env.
CHAT_MODEL_PROVIDER=mock
WEB_SEARCH_PROVIDER=mock

# Enable these after adding both API keys:
# CHAT_MODEL_PROVIDER=openai
# WEB_SEARCH_PROVIDER=exa
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
EXA_API_KEY=

CHAT_PROVIDER_TIMEOUT=20
CHAT_WEB_RESULT_LIMIT=4
CHAT_SITE_RESULT_LIMIT=12
CHAT_CATALOG_RESULT_LIMIT=200
CHAT_WEB_CONTENT_MAX_CHARS=10000
CHAT_WEB_CONTENT_TOTAL_MAX_CHARS=24000
CHAT_PLAN_MAX_OUTPUT_TOKENS=1200
CHAT_CLARIFICATION_MAX_OUTPUT_TOKENS=500
CHAT_ANSWER_MAX_OUTPUT_TOKENS=1600
CHAT_LIST_MAX_OUTPUT_TOKENS=6000
CHAT_TITLE_MATCH_MAX_OUTPUT_TOKENS=3000
CHAT_REQUESTS_PER_MINUTE=10
CHAT_RATE_LIMIT_DIR=/tmp/audiobooks-chat-limits
